{
  "name": "@opengrokbot/gateway",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "OPENGROKBOT_WEB_URL=${OPENGROKBOT_WEB_URL:-http://localhost:5173} tsx watch src/main.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/main.js",
    "typecheck": "tsc --noEmit -p .",
    "test": "vitest run",
    "smoke:docker": "tsx scripts/smoke-docker.ts"
  },
  "dependencies": {
    "@hono/node-server": "^1.19.17",
    "@hono/node-ws": "^1.3.1",
    "@novnc/novnc": "1.7.0",
    "better-sqlite3": "^13.0.3",
    "croner": "^10.0.1",
    "dockerode": "^5.0.1",
    "hono": "^4.13.14",
    "playwright-core": "^1.64.1"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/dockerode": "^4.0.2",
    "@types/node": "^26.6.5",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  }
}
