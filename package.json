{
  "name": "opengrokbot",
  "private": true,
  "packageManager": "pnpm@10.33.2",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm --parallel --filter @opengrokbot/gateway --filter @opengrokbot/web dev",
    "build": "pnpm --filter @opengrokbot/web build && pnpm --filter @opengrokbot/gateway build",
    "start": "pnpm --filter @opengrokbot/gateway start",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r --workspace-concurrency=1 test"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "better-sqlite3",
      "esbuild"
    ]
  }
}
